{
  "name": "hd2lab-gamehub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "validate": "node scripts/validate-catalog.mjs",
    "test": "node --test tests/catalog.test.mjs",
    "build": "node scripts/build.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run validate && npm test && npm run build && npm run test:e2e",
    "check:links": "node scripts/check-links.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0"
  }
}
